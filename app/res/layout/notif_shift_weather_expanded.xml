<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notif_bg_obsidian"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Top Luxury Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_shield_gold"
            android:layout_marginEnd="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOHERTY SECURITY SERVICES"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/notif_exp_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFICER SHIFT BRIEFING &amp; DISPATCH"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_exp_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IN 11 HOURS"
            android:textColor="#10B981"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:background="@drawable/notif_pill_emerald"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Shift & Station Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/notif_stat_box"
        android:padding="8dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_exp_guard_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡️ Officer Brian Rush"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_exp_time_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00 – 00:00 (4.0h)"
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_exp_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Hume Doors &amp; Timber · Post 01 Gatehouse"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Environmental & Weather Telemetry Matrix (3 Columns) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <!-- Column 1: Temperature -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/notif_stat_box"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMBIENT"
                android:textColor="#64748B"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_exp_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14.5°C"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/notif_exp_temp_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Low 11.8°C"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Column 2: Rain & Wind -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/notif_stat_box"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAIN RISK"
                android:textColor="#64748B"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_exp_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0% (Dry)"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/notif_exp_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💨 10 km/h"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Column 3: Conditions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/notif_stat_box"
            android:padding="6dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONDITIONS"
                android:textColor="#64748B"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_exp_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear Skies"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙 Fine Night"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Uniform & Weather Advisory Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/notif_stat_box"
        android:padding="7dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🦺 UNIFORM &amp; WEATHER ADVISORY"
            android:textColor="#D97706"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="1dp" />

        <TextView
            android:id="@+id/notif_exp_gear_advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Winter duty fleece, thermal underlayer, &amp; warm beanie advised. Standard Gatehouse duty uniform &amp; torch."
            android:textColor="#E2E8F0"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👑 Doherty Security Services · Deputy API Sync"
            android:textColor="#475569"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 INSPECT ROSTER"
            android:textColor="#14B8A6"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:background="@drawable/notif_pill_teal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

</LinearLayout>
