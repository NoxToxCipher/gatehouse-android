<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ GATEHOUSE DSS"
            android:textColor="#FFFFD166"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ON SHIFT (68%)"
            android:textColor="#FF10B981"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/widget_chip_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/widget_facility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hume Doors Kingston · Post 01 (18:00–06:00)"
        android:textColor="#FF94A3B8"
        android:textSize="10.5sp"
        android:paddingTop="1dp"
        android:paddingBottom="4dp" />

    <!-- Shift Progress Percentage Bar -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="68"
        android:progressDrawable="@drawable/widget_progress_drawable" />

    <!-- Progress Timing Details -->
    <TextView
        android:id="@+id/widget_progress_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏱️ 5h 22m elapsed · 2h 38m left (06:00 Handover)"
        android:textColor="#FFF1F5F9"
        android:textSize="10sp"
        android:paddingTop="3dp"
        android:paddingBottom="5dp" />

    <!-- Telemetry Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_patrol_due"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱️ Next: 00:00 (Ext)"
            android:textColor="#FF94A3B8"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/widget_psi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚰 1,200 PSI ✓"
            android:textColor="#FF10B981"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Action Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_torch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="🔦 Torch"
            android:textColor="#FFFFD166"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_incident"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="🚨 Incident"
            android:textColor="#FFFF4D6D"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="📝 Note"
            android:textColor="#FF38BDF8"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
