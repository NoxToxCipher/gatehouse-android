<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notif_bg_obsidian"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Top Luxury Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="3dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_shield_gold"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/notif_header_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DOHERTY SECURITY SERVICES"
            android:textColor="#F59E0B"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/notif_header_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IN 12 HOURS"
            android:textColor="#FBBF24"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/notif_pill_amber"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp" />
    </LinearLayout>

    <!-- Main Title: Officer & Hours -->
    <TextView
        android:id="@+id/notif_main_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Officer Brian Rush · 20:00 – 00:00 (4.0h)"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Station & Quick Telemetry -->
    <TextView
        android:id="@+id/notif_main_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Post 01 · 🌤️ 14.5°C (Low 11.8°C) · 💧 0% Rain"
        android:textColor="#94A3B8"
        android:textSize="10.5sp"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
